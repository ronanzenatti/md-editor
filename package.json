{
  "name": "md-editor",
  "version": "1.0.0",
  "description": "A Markdown Editor with Git integration running on Electron and Web",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start:server": "node server/server.js",
    "start:electron": "electron .",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "install:all": "npm install && npm --prefix frontend install",
    "dev": "concurrently \"npm run start:server\" \"npm run dev:frontend\"",
    "app": "electron .",
    "dist:electron": "npm run build:frontend && npx electron-packager . MD-Editor --platform=win32 --arch=x64 --out=dist-app --icon=assets/icon.ico --overwrite --ignore=\"^/(frontend/(src|node_modules|public)|dist-app|\\.git|\\.github)\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0"
  },
  "build": {
    "appId": "com.mdeditor.app",
    "productName": "MD-Editor",
    "icon": "assets/icon.ico",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MD-Editor"
    }
  }
}
